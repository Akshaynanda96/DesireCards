<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="20dp">

    <!-- Turn Header -->
    <TextView
        android:id="@+id/turn_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="His Turn - Akshay 💙"
        android:textSize="22sp"
        android:fontFamily="@font/playfair_display"
        android:textStyle="bold"
        android:textColor="#0077FD"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <!-- Card Wrapper -->
    <FrameLayout
        android:id="@+id/card_wrapper"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        app:layout_constraintTop_toBottomOf="@id/turn_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp">

        <!-- Card Outer -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="36dp"
            app:cardElevation="30dp"
            app:cardBackgroundColor="@android:color/transparent">

            <!-- CARD CONTAINER -->
            <FrameLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- FRONT CARD -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_inner"
                    android:padding="45dp">

                    <TextView
                        android:id="@+id/card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task #1"
                        android:textSize="28sp"
                        android:fontFamily="@font/playfair_display"
                        android:textColor="#FF3399"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/card_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#FFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/card_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <Button
                        android:id="@+id/play_btn"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginTop="232dp"
                        android:background="@drawable/play_button"
                        android:text="▶"
                        android:textColor="#FFFFFF"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- BACK CARD -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_back"
                    android:padding="45dp"
                    android:visibility="gone"
                    android:rotationY="180">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Desire Cards 🔥"
                        android:textSize="26sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Next Button -->
    <Button
        android:id="@+id/next_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:background="@drawable/button_gradient"
        android:fontFamily="@font/poppins"
        android:paddingHorizontal="50dp"
        android:paddingVertical="18dp"
        android:text="Her Turn Next →"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_wrapper" />

    <!-- COMPLETION SCREEN – placed at the bottom of root_layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/completion_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/completion_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Tasks Completed! 🔥💦"
            android:textSize="36sp"
            android:fontFamily="@font/playfair_display"
            android:textColor="#FF3366"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="40dp" />

        <TextView
            android:id="@+id/completion_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You both explored every naughty desire tonight 😈\nTime for the real fun..."
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/completion_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Restart Button -->
        <Button
            android:id="@+id/restart_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restart Game →"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_gradient"
            android:paddingHorizontal="50dp"
            android:paddingVertical="18dp"
            android:layout_marginTop="60dp"
            app:layout_constraintTop_toBottomOf="@id/completion_message"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome_back_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="40dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back, Lovers 💕"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:fontFamily="@font/playfair_display"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:shadowColor="#FF3366"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your naughty fantasies are waiting...\nDo you want to continue where you left off?"
        android:textSize="18sp"
        android:textColor="#FFDDFF"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="60dp" />

    <!-- Buttons -->
    <Button
        android:id="@+id/btn_resume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/button_gradient_pink_glow"
        android:paddingVertical="20dp"
        android:text="Resume Our Story ❤️"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/playfair_display"
        android:elevation="8dp" />

    <Button
        android:id="@+id/btn_start_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_gradient_purple"
        android:paddingVertical="20dp"
        android:text="Start Fresh 🔥"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/playfair_display"
        android:elevation="8dp" />

    <!-- Optional small heart animation or text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="🔥💦❤️"
        android:textSize="36sp"
        android:alpha="0.7" />

</LinearLayout>